# MongoDB Atlas connection string (server-side only)
MONGODB_URI=mongodb+srv://USER:PASSWORD@HOST/?retryWrites=true&w=majority
MONGODB_DB=student_performanceDB
# Required random secret used to sign/derive session values; use at least 32 random bytes
SESSION_SECRET=replace-with-a-random-secret-of-at-least-32-bytes
# Optional: exact public origin for production CSRF checks, e.g. https://student-performance-classroom.vercel.app
APP_ORIGIN=
# Optional: enables the local-only dev seed command; never set this in production
ALLOW_DEMO_SEED=false
